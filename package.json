{
  "name": "localbot",
  "version": "1.2.0",
  "description": "Personal bots that run entirely on your own computer and local models.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {"localbot": "bin/localbot.mjs"},
  "files": ["bin", "runtime", "ui"],
  "engines": {"node": ">=22.18"},
  "scripts": {
    "test": "node --test tests/*.test.mjs",
