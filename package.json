{
  "name": "localbot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "start": "node runtime/dist/server.js",
    "test": "npm run build && node --test --test-concurrency=1 runtime/tests/*.test.mjs",
    "app": "bash scripts/build-app.sh",
    "check": "npm test && swift build --package-path macos -j 1",
    "test:packaged-subscription": "node scripts/packaged-runtime-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  }
}
